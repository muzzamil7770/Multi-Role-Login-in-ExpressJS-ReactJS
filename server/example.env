# Application port used by the Express server
APP_PORT=5000

# Secret key used to sign session cookies
SESS_SECRET=change_this_to_a_long_random_secret_key

# Database connection settings
DB_HOST=localhost
DB_PORT=3306
DB_NAME=auth_db
DB_USER=root
DB_PASSWORD=
DB_DIALECT=mysql

# Email Service Configuration (Nodemailer)
# For Gmail: Enable 2FA and generate an App Password at https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Client URL for CORS and Socket.io
CLIENT_URL=http://localhost:3000

# Node Environment (development | production)
NODE_ENV=development
